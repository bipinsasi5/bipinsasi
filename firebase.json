{
  "hosting": {
    "public": "build",
    "site": "latest-news-india",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/**",
        "destination": "https://bipinsasi.com/:splat",
        "type": 301
      }
    ]
  }
}